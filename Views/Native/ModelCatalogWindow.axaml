<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SlimCodeDesktop.Views.Native.ModelCatalogWindow"
        Title="Providers &amp; models"
        Width="1180" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

   <Grid RowDefinitions="Auto,*,Auto" Margin="14">

      <!-- Intro -->
      <TextBlock Grid.Row="0"
                 Text="OpenAI-compatible providers the agent can talk to. Each provider has a name, endpoint, optional API key, and its own models. Discover queries a provider's /v1/models list and lets you pick which ones to add; edit context windows to match what each model actually supports — the gauge in the chat header uses this value as the denominator."
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextMutedStrongBrush}"
                 Margin="0,0,0,10"/>

      <!-- Rows list -->
      <Border Grid.Row="1"
              BorderBrush="{DynamicResource BorderColorBrush}"
              BorderThickness="1">
         <ScrollViewer>
            <StackPanel x:Name="RowsPanel" Spacing="2" Margin="6"/>
         </ScrollViewer>
      </Border>

      <!-- Footer -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,10,0,0">
         <Button Grid.Column="0" x:Name="BtnAdd"
                 Content="+ Add provider"
                 Padding="10,4"
                 Click="BtnAdd_Click"/>
         <Button Grid.Column="2" x:Name="BtnCancel"
                 Content="Cancel"
                 Padding="14,4"
                 Margin="6,0,0,0"
                 Click="BtnCancel_Click"/>
         <Button Grid.Column="3" x:Name="BtnSave"
                 Content="Save"
                 Padding="14,4"
                 Margin="6,0,0,0"
                 FontWeight="Bold"
                 Click="BtnSave_Click"/>
      </Grid>
   </Grid>
</Window>
