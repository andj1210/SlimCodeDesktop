<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SlimCodeDesktop.Views.Native.ModelDiscoveryWindow"
        Title="Discovered models"
        Width="780" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

   <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="14">

      <!-- Intro -->
      <TextBlock Grid.Row="0"
                 x:Name="TxtIntro"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextMutedStrongBrush}"
                 Margin="0,0,0,10"/>

      <!-- Filter strip -->
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
         <TextBox Grid.Column="0"
                  x:Name="TxtFilter"
                  PlaceholderText="filter — space-separated terms, all must match (e.g. &quot;qwen 30b&quot;)"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  Background="{DynamicResource PanelBackgroundBrush}"
                  CaretBrush="{DynamicResource TextPrimaryBrush}"
                  BorderBrush="{DynamicResource BorderColorBrush}"/>
         <Button Grid.Column="1"
                 x:Name="BtnAll"
                 Content="Select all"
                 Padding="10,4"
                 Margin="6,0,0,0"/>
         <Button Grid.Column="2"
                 x:Name="BtnNone"
                 Content="Clear"
                 Padding="10,4"
                 Margin="6,0,0,0"/>
      </Grid>

      <!-- New models -->
      <Border Grid.Row="2"
              BorderBrush="{DynamicResource BorderColorBrush}"
              BorderThickness="1">
         <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    x:Name="HeaderHost"
                    BorderBrush="{DynamicResource BorderColorBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="4,4"/>
            <!--
               ListBox, not ItemsControl+ScrollViewer: the ListBox template owns
               the ScrollViewer its VirtualizingStackPanel needs as scroll
               owner. The styles below strip the selection chrome — rows are
               picked with their radios, list selection means nothing here.
            -->
            <ListBox Grid.Row="1"
                     x:Name="ListNew"
                     Margin="0,2,0,0"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
               <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                     <Setter Property="Padding" Value="0"/>
                     <Setter Property="MinHeight" Value="0"/>
                     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  </Style>
                  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                     <Setter Property="Background" Value="Transparent"/>
                  </Style>
                  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                     <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                  </Style>
               </ListBox.Styles>
            </ListBox>
            <TextBlock Grid.Row="1"
                       x:Name="TxtEmpty"
                       FontStyle="Italic"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="8,8"
                       IsVisible="False"/>
         </Grid>
      </Border>

      <!--
         Gone from the server: catalog entries discovery did not find any more.
         Same three-column layout as the table above, different verdicts.
      -->
      <StackPanel Grid.Row="3" x:Name="StaleSection" Spacing="3" Margin="0,10,0,0">
         <TextBlock x:Name="TxtStale"
                    FontSize="11"
                    Foreground="{DynamicResource TextMutedBrush}"/>
         <Border BorderBrush="{DynamicResource BorderColorBrush}"
                 BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
               <Border Grid.Row="0"
                       x:Name="StaleHeaderHost"
                       BorderBrush="{DynamicResource BorderColorBrush}"
                       BorderThickness="0,0,0,1"
                       Padding="4,4"/>
               <ListBox Grid.Row="1"
                        x:Name="ListStale"
                        MaxHeight="180"
                        Margin="0,2,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.Styles>
                     <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                     </Style>
                     <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                     </Style>
                     <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                     </Style>
                  </ListBox.Styles>
               </ListBox>
            </Grid>
         </Border>
      </StackPanel>

      <!-- Already in the catalog: context only, never selectable -->
      <StackPanel Grid.Row="4" x:Name="KnownSection" Spacing="3" Margin="0,10,0,0">
         <TextBlock x:Name="TxtKnown"
                    FontSize="11"
                    Foreground="{DynamicResource TextMutedBrush}"/>
         <Border BorderBrush="{DynamicResource BorderColorBrush}"
                 BorderThickness="1">
            <ListBox x:Name="ListKnown"
                     MaxHeight="110"
                     Margin="0,2"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
               <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                     <Setter Property="Padding" Value="0"/>
                     <Setter Property="MinHeight" Value="0"/>
                     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  </Style>
                  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                     <Setter Property="Background" Value="Transparent"/>
                  </Style>
               </ListBox.Styles>
            </ListBox>
         </Border>
      </StackPanel>

      <!-- Footer -->
      <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,12,0,0">
         <TextBlock Grid.Column="0"
                    x:Name="TxtCounts"
                    FontSize="11"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextMutedBrush}"/>
         <Button Grid.Column="2"
                 x:Name="BtnCancel"
                 Content="Cancel"
                 Padding="14,4"
                 Margin="6,0,0,0"
                 Click="BtnCancel_Click"/>
         <Button Grid.Column="3"
                 x:Name="BtnApply"
                 Content="Apply"
                 Padding="14,4"
                 Margin="6,0,0,0"
                 FontWeight="Bold"
                 Click="BtnApply_Click"/>
      </Grid>
   </Grid>
</Window>
