<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Target OS selection. Defaults to the build host; override explicitly to
    cross-compile:  dotnet build -p:TargetOS=Linux

    Deliberately NOT keyed on IsOSPlatform at the point of use: that would
    describe the machine doing the build, so `dotnet publish -r linux-x64`
    from Windows would silently compile the Windows sources in.
  -->
  <PropertyGroup>
    <TargetOS Condition="'$(TargetOS)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))">Windows</TargetOS>
    <TargetOS Condition="'$(TargetOS)' == ''">Linux</TargetOS>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.0.5</Version>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- WinExe suppresses the console window; meaningless off Windows. -->
    <OutputType Condition="'$(TargetOS)' == 'Windows'">WinExe</OutputType>
    <OutputType Condition="'$(TargetOS)' != 'Windows'">Exe</OutputType>
    <ApplicationManifest Condition="'$(TargetOS)' == 'Windows'">app.manifest</ApplicationManifest>
    <!-- Exe icon (Explorer, taskbar). Generated by tools/make-icons.cs. -->
    <ApplicationIcon Condition="'$(TargetOS)' == 'Windows'">assets\icon\slimcode.ico</ApplicationIcon>

    <DefineConstants>$(DefineConstants);PLATFORM_$(TargetOS.ToUpperInvariant())</DefineConstants>
  </PropertyGroup>

  <!--
    Builds from the dev branch are marked "-dev" in the informational version,
    which AppInfo.Version and the window title show ("0.0.2-dev"). Read
    straight from .git/HEAD, so no git executable is needed. Release builds
    in CI check out a detached commit, so they never get the suffix. <Version>
    itself is untouched: archive names and the updater's comparison use it.
  -->
  <PropertyGroup>
    <_GitHeadFile>$(MSBuildProjectDirectory)\.git\HEAD</_GitHeadFile>
    <_GitHead Condition="Exists('$(_GitHeadFile)')">$([System.IO.File]::ReadAllText('$(_GitHeadFile)').Trim())</_GitHead>
    <InformationalVersion Condition="'$(_GitHead)' == 'ref: refs/heads/dev'">$(Version)-dev</InformationalVersion>
  </PropertyGroup>

  <!--
    Exactly one Platform/Platform.<OS>.cs compiles. The inactive one is
    invisible to the compiler, so build it periodically to catch drift:
    dotnet build -p:TargetOS=Linux
  -->
  <ItemGroup>
    <Compile Remove="Platform\Platform.Windows.cs" Condition="'$(TargetOS)' != 'Windows'" />
    <Compile Remove="Platform\Platform.Linux.cs" Condition="'$(TargetOS)' != 'Linux'" />
  </ItemGroup>

  <!--
    Keep the SDK's default **/*.cs globbing out of folders that hold other
    projects' sources: Tests\ (built via the solution), tools\ (standalone
    file-based scripts, see the usage line in each) and packages\ (the
    project-local NuGet cache — test packages such as xunit.v3 ship .cs
    content files there).
  -->
  <ItemGroup>
    <Compile Remove="Tests\**;tools\**;packages\**" />
    <None Remove="Tests\**;tools\**;packages\**" />
    <AvaloniaXaml Remove="Tests\**;tools\**;packages\**" />
  </ItemGroup>

  <!-- Raster icons for the window, title bar and About page (avares://). The
       SVG sources stay out of the binary. -->
  <ItemGroup>
    <AvaloniaResource Include="assets\icon\*.png;assets\icon\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="SkiaSharp" Version="3.119.4-preview.1.1" />
  </ItemGroup>
</Project>
