<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Project-local package cache (like node_modules).
         Comment this out to fall back to the global cache (~/.nuget/packages). -->
    <add key="globalPackagesFolder" value="packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
